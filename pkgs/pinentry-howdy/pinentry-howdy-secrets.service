[Unit]
Description=Root Secret Service for pinentry-howdy
After=pinentry-howdy.socket

[Service]
Type=notify
ExecStart=@secrets@
User=root
Group=root
RuntimeDirectory=pinentry-howdy
RuntimeDirectoryMode=0750
RuntimeDirectoryGroup=users
Environment=HOME=/root
Restart=on-failure
RestartSec=2
NotifyAccess=main

[Install]
WantedBy=multi-user.target
